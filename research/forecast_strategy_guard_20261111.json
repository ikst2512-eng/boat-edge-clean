{
  "schema": "BOAT_EDGE_CLEAN_FORECAST_STRATEGY_GUARD_V1",
  "as_of_jst": "2026-11-11",
  "purpose": "Prevent silent replacement of the previously agreed, scenario-first prediction research by a national-win-rate-only baseline.",
  "legacy_source_of_truth": {
    "repository": "ikst2512-eng/boat-edge",
    "path": "data/site_prediction_policy.json",
    "schema_version": "boat-edge-latest-prediction-policy-v127",
    "site_reference_modes": "V133: hit10 balance10 wave12/15/18 narrow3",
    "status": "historical design and reference; not an approved live model in CLEAN"
  },
  "requirements_owner": "https://github.com/ikst2512-eng/boat-edge-clean/issues/1708",
  "baseline": {
    "model_version": "CLEAN_FOUR_MODES_V2_PROVISIONAL_UNCALIBRATED",
    "role": "existing research/archive comparator only",
    "inputs_actually_scored": ["six_national_win_rates", "static_1000_race_boat_index_prior"],
    "modes": {"narrow": 5, "hit": 10, "balance": 16, "hole": 22},
    "scenario_awareness": false,
    "official_exhibition_actually_consumed": false,
    "formally_calibrated": false,
    "approved_purchase_decision": false
  },
  "scenario_first_target": {
    "status": "research_only_until_independent_prospective_validation",
    "research_owners": ["#1692", "#1693", "#1698", "#1710", "#1746"],
    "scenario_worlds": ["one_escape_with_second_course_wall", "second_course_sashi", "third_course_attack", "fourth_kado_attack", "fifth_sixth_beneficiary", "deep_entry_or_course_change", "venue_wind_wave_tide_interaction"],
    "conditional_probability_order": ["P(first|race_inputs,scenario)", "P(second|first,race_inputs,scenario)", "P(third|first,second,race_inputs,scenario)"],
    "evidence_fields": ["actual_entry_vs_exhibition_entry", "race_course_wins_and_finishes", "second_course_escape_assist_and_sashi", "start_timing_and_exhibition", "motor_and_original_exhibition", "venue_wind_wave_tide", "same_day_pre_race_live_priors", "source_sha256_and_received_at"],
    "odds_may_rerank_probabilities": false,
    "missing_evidence": "unknown_or_not_used_not_zero_and_not_claimed_used",
    "final_recommendation_tickets_max": 10,
    "user_budgets_yen": [5000, 10000]
  },
  "promotion_gate": {
    "prior_frozen_forecasts_and_confirmed_outcomes_preserved": true,
    "registered_separate_model_identity_before_future_cohort": true,
    "same_race_same_budget_comparison": true,
    "pre_deadline_verified_full_source_and_actual_model_consumption": true,
    "independent_remote_first_receipt_verified": true,
    "pilot_future_races": 300,
    "confirmation_future_races": 300,
    "compare_top_n": [1, 3, 5, 10],
    "do_not_promote_if_top5_or_top10_worsens": true,
    "human_review_and_public_release_verification_required": true,
    "no_silent_mode_budget_or_model_substitution": true
  },
  "do_not_delete_without_independent_reference_audit": [
    "four_mode_forecasts/",
    "research_snapshots/",
    "prospective_predictions/",
    "confirmed_results/",
    "payout_evidence/",
    "research/",
    "scripts/audit_*",
    "historical_research_prs_and_ci_artifacts"
  ]
}
